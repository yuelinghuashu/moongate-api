# Server
PORT=8080

# 运行环境：只有显式写成 development，本地放行规则（localhost / 127.0.0.1 / [::1] 任意端口）才生效。
# 缺了这一行，后端会把你的前端请求全部 403 —— 症状是"客户端跳转没数据、刷新才有"。
# 生产不要设置它（或设为 production）。
ENV=development

# 允许的跨源来源（逗号分隔）。设置后优先于上面的本地放行规则；
# 只有需要别的来源时才配，例如手机真机调试：
# CORS_ORIGINS=http://localhost:3000,http://192.168.1.10:3000
